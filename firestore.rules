rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// VYOM NETWORK — Firestore Security Rules
// Closed-loop educational fintech simulator (see project_rules.md).
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@vyom.network';
    }

    // Money / identity fields the client console must never be able to edit.
    function onlySafeFieldsChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'email',
        'role',
        'activeCards',
        'availableFund',
        'bonusUnlocked',
        'lockedBonus',
        'referralCode',
        'referredBy',
        'referralEarnings',
        'referralCount',
        'secondaryCount',
        'referralRewarded',
        'cardActivatedAt',
        'customDeposits',
        'joinDate'
      ]);
    }

    // redeemedGross can only go up (anti double-spend) and must match any new redeem request.
    function redeemedGrossValid() {
      let prevRedeemed = resource.data.get('redeemedGross', 0);
      let nextRedeemed = request.resource.data.get('redeemedGross', 0);
      let prevRedeems = resource.data.get('pendingRedeems', []);
      let nextRedeems = request.resource.data.get('pendingRedeems', []);

      return nextRedeemed is number
        && nextRedeemed >= prevRedeemed
        && (nextRedeems.size() == prevRedeems.size()
            ? nextRedeemed == prevRedeemed
            : nextRedeemed >= prevRedeemed + 500);
    }

    // Passbook entries can only be prepended or appended without altering existing logs.
    function historyUnchangedOrAppended() {
      let prev = resource.data.get('history', []);
      let next = request.resource.data.get('history', []);
      return next.size() == prev.size()
        ? next == prev
        : next.size() == prev.size() + 1
          && (prev.size() == 0 || next[1] == prev[0] || next[0] == prev[0]);
    }

    // A queue may either be left untouched, or grow by one PREPENDED "pending" entry.
    function purchasesUnchangedOrAppended() {
      let prev = resource.data.get('pendingPurchases', []);
      let next = request.resource.data.get('pendingPurchases', []);
      return next.size() == prev.size()
        ? next == prev
        : next.size() == prev.size() + 1
          && next[0].status == 'pending'
          && next[0].amount is number
          && next[0].amount >= 100
          && next[0].type in ['card_purchase', 'custom_deposit']
          && (prev.size() == 0 || next[1] == prev[0]);
    }

    function redeemsUnchangedOrAppended() {
      let prev = resource.data.get('pendingRedeems', []);
      let next = request.resource.data.get('pendingRedeems', []);
      let reqAmt = next.size() > 0 ? next[0].get('grossAmount', next[0].get('amount', 0)) : 0;
      return next.size() == prev.size()
        ? next == prev
        : next.size() == prev.size() + 1
          && next[0].status == 'pending'
          && reqAmt is number
          && reqAmt >= 500
          && (prev.size() == 0 || next[1] == prev[0]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user')
             == (request.auth.token.email == 'admin@vyom.network' ? 'admin' : 'user')
        && request.resource.data.activeCards == []
        && request.resource.data.pendingPurchases == []
        && request.resource.data.pendingRedeems == []
        && request.resource.data.get('customDeposits', []) == []
        && request.resource.data.availableFund == 0
        && request.resource.data.bonusUnlocked == false;

      allow update: if isAdmin()
        || (isOwner(userId)
            && onlySafeFieldsChanged()
            && redeemedGrossValid()
            && historyUnchangedOrAppended()
            && purchasesUnchangedOrAppended()
            && redeemsUnchangedOrAppended());

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
